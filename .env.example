# Copien este archivo como .env y cambien los valores antes de levantar el despliegue.
# El archivo .env no se sube al repositorio.

# Contraseña del usuario barberia en la base de datos del despliegue.
DB_PASSWORD=cambien-esta-clave

# Secreto para firmar los tokens de sesión: mínimo 32 caracteres, distinto en cada despliegue.
JWT_SECRETO=cambien-este-secreto-por-uno-largo-y-aleatorio

# Puerto donde queda la aplicación en este computador.
PUERTO_WEB=8080
