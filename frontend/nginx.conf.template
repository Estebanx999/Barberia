server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # La API se reenvía al backend: el navegador ve un solo origen y no hace falta CORS.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Los archivos compilados llevan un hash en el nombre: se pueden guardar en caché.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Rutas de la aplicación (React Router): todas responden con index.html.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
