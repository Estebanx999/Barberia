server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

    # La API se reenvía al backend: el navegador ve un solo origen y no hace falta CORS.
    # Con la dirección en una variable, Nginx no exige que el backend responda al arrancar.
    location /api/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_ssl_server_name on;
        # En la nube el backend gratuito se duerme y tarda cerca de un minuto en despertar.
        proxy_connect_timeout 75s;
        proxy_read_timeout 120s;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Los archivos compilados llevan un hash en el nombre: se pueden guardar en caché.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Rutas de la aplicación (React Router): todas responden con index.html.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
